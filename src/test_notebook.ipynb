       "torch.return_types.max(\n",
       "values=tensor(1.),\n",
       "indices=tensor(2))"
      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "a = torch.asarray([-1000.,-1000, 10 , -1000], dtype=torch.float32) \n",
    "calculate_confidence_score(a)\n"
   ]
