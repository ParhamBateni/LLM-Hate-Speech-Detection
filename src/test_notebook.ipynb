   "id": "e7cd4b49",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def calculate_confidence_score(logits: torch.Tensor):\n",
    "    return torch.softmax(logits, dim=-1).max(dim=-1).values.log().sum(dim=-1).exp()\n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "44fa7085",
